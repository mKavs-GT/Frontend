{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/Home" },
    { "source": "/index.html", "destination": "/Home" },
    { "source": "/Portfolio/Ecommerce/Bag", "destination": "/Portfolio/E-Commerce/hush" },
    { "source": "/Portfolio/Ecommerce/Ink", "destination": "/Portfolio/E-Commerce/slick" },
    { "source": "/Portfolio/Ecommerce/Kaizoku", "destination": "/Portfolio/E-Commerce/kaizoku" },
    { "source": "/Portfolio/Ecommerce/Wegrow", "destination": "/Portfolio/E-Commerce/wegrow" },
    { "source": "/Portfolio/Ecommerce/Bag/(.*)", "destination": "/Portfolio/E-Commerce/hush/$1" },
    { "source": "/Portfolio/Ecommerce/Ink/(.*)", "destination": "/Portfolio/E-Commerce/slick/$1" },
    { "source": "/Portfolio/Ecommerce/Kaizoku/(.*)", "destination": "/Portfolio/E-Commerce/kaizoku/$1" },
    { "source": "/Portfolio/Ecommerce/Wegrow/(.*)", "destination": "/Portfolio/E-Commerce/wegrow/$1" }
  ],
  "rewrites": [
    { "source": "/Home", "destination": "/index.html" },
    { "source": "/About", "destination": "/about/index.html" },
    { "source": "/Works", "destination": "/works-build/index.dev.html" },
    { "source": "/Branding", "destination": "/branding/index.html" },
    { "source": "/Pricing", "destination": "/pricingpage/index.html" },
    { "source": "/BookUs", "destination": "/loginpg/index.html" },
    { "source": "/Consult", "destination": "/consult/index.html" },
    { "source": "/Support", "destination": "/support/index.html" },
    { "source": "/Login", "destination": "/loginpg/index.html" }
  ]
}
