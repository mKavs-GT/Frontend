{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/About",
      "destination": "/frontend/about/about.html"
    },
    {
      "source": "/Works",
      "destination": "/frontend/works/index.html"
    },
    {
      "source": "/Branding",
      "destination": "/frontend/branding/branding.html"
    },
    {
      "source": "/Pricing",
      "destination": "/frontend/pricingpage/pricing.html"
    },
    {
      "source": "/BookUs",
      "destination": "/frontend/loginpg/login.html"
    },
    {
      "source": "/Consult",
      "destination": "/frontend/consult/consult.html"
    },
    {
      "source": "/Support",
      "destination": "/frontend/support/support.html"
    },
    {
      "source": "/Login",
      "destination": "/frontend/loginpg/login.html"
    },
    {
      "source": "/mobile",
      "destination": "/Mobile/frontend/index.html"
    },
    {
      "source": "/mobile/:path*",
      "destination": "/Mobile/frontend/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/frontend/admin/dist/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/frontend/admin/dist/index.html"
    },
    {
      "source": "/images/:path*",
      "destination": "/frontend/images/:path*"
    },
    {
      "source": "/config.js",
      "destination": "/frontend/config.js"
    },
    {
      "source": "/scripts.js",
      "destination": "/frontend/scripts.js"
    },
    {
      "source": "/sticky-navbar.js",
      "destination": "/frontend/sticky-navbar.js"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/styles.css"
    },
    {
      "source": "/branding.html",
      "destination": "/frontend/branding/branding.html"
    },
    {
      "source": "/branding",
      "destination": "/frontend/branding/branding.html"
    },
    {
      "source": "/branding/:path*",
      "destination": "/frontend/branding/:path*"
    },
    {
      "source": "/works/:path*",
      "destination": "/frontend/works/:path*"
    },
    {
      "source": "/brandpg/:path*",
      "destination": "/Mobile/frontend/brandpg/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "/frontend/about/:path*"
    },
    {
      "source": "/pricingpage/:path*",
      "destination": "/frontend/pricingpage/:path*"
    },
    {
      "source": "/consult/:path*",
      "destination": "/frontend/consult/:path*"
    },
    {
      "source": "/support/:path*",
      "destination": "/frontend/support/:path*"
    },
    {
      "source": "/loginpg/:path*",
      "destination": "/frontend/loginpg/:path*"
    },
    {
      "source": "/profile/:path*",
      "destination": "/frontend/profile/:path*"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/frontend/portfolio/:path*"
    },
    {
      "source": "/signpg/:path*",
      "destination": "/frontend/signpg/:path*"
    }
  ]
}
