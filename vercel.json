{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/About",
      "destination": "/about/about.html"
    },
    {
      "source": "/Works",
      "destination": "/works/index.html"
    },
    {
      "source": "/Branding",
      "destination": "/branding/branding.html"
    },
    {
      "source": "/Pricing",
      "destination": "/pricingpage/pricing.html"
    },
    {
      "source": "/BookUs",
      "destination": "/loginpg/login.html"
    },
    {
      "source": "/Consult",
      "destination": "/consult/consult.html"
    },
    {
      "source": "/Support",
      "destination": "/support/support.html"
    },
    {
      "source": "/Login",
      "destination": "/loginpg/login.html"
    },
    {
      "source": "/mobile",
      "destination": "/Mobile/frontend/index.html"
    },
    {
      "source": "/mobile/:path*",
      "destination": "/Mobile/frontend/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/dist/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/dist/index.html"
    },
    {
      "source": "/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/scripts.js",
      "destination": "/scripts.js"
    },
    {
      "source": "/sticky-navbar.js",
      "destination": "/sticky-navbar.js"
    },
    {
      "source": "/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/branding.html",
      "destination": "/branding/branding.html"
    },
    {
      "source": "/branding",
      "destination": "/branding/branding.html"
    },
    {
      "source": "/branding/:path*",
      "destination": "/branding/:path*"
    },
    {
      "source": "/works/:path*",
      "destination": "/works/:path*"
    },
    {
      "source": "/brandpg/:path*",
      "destination": "/Mobile/frontend/brandpg/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "/about/:path*"
    },
    {
      "source": "/pricingpage/:path*",
      "destination": "/pricingpage/:path*"
    },
    {
      "source": "/consult/:path*",
      "destination": "/consult/:path*"
    },
    {
      "source": "/support/:path*",
      "destination": "/support/:path*"
    },
    {
      "source": "/loginpg/:path*",
      "destination": "/loginpg/:path*"
    },
    {
      "source": "/profile/:path*",
      "destination": "/profile/:path*"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/portfolio/:path*"
    },
    {
      "source": "/signpg/:path*",
      "destination": "/signpg/:path*"
    }
  ]
}