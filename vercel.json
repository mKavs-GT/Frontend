{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mobile/:path*",
      "destination": "/mobile/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/frontend/images/:path*"
    },
    {
      "source": "/config.js",
      "destination": "/frontend/config.js"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}