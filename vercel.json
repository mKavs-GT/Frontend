{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/mobile/:path*",
      "destination": "/mobile/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/frontend/images/:path*"
    },
    {
      "source": "/config.js",
      "destination": "/frontend/config.js"
    },
    {
      "source": "/scripts.js",
      "destination": "/frontend/scripts.js"
    },
    {
      "source": "/sticky-navbar.js",
      "destination": "/frontend/sticky-navbar.js"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/styles.css"
    },
    {
      "source": "/branding.html",
      "destination": "/frontend/branding.html"
    },
    {
      "source": "/branding",
      "destination": "/frontend/branding.html"
    },
    {
      "source": "/brandpg/:path*",
      "destination": "/mobile/brandpg/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "/frontend/about/:path*"
    },
    {
      "source": "/pricingpage/:path*",
      "destination": "/frontend/pricingpage/:path*"
    },
    {
      "source": "/consult/:path*",
      "destination": "/frontend/consult/:path*"
    },
    {
      "source": "/support/:path*",
      "destination": "/frontend/support/:path*"
    },
    {
      "source": "/loginpg/:path*",
      "destination": "/frontend/loginpg/:path*"
    },
    {
      "source": "/profile/:path*",
      "destination": "/frontend/profile/:path*"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/frontend/portfolio/:path*"
    },
    {
      "source": "/signpg/:path*",
      "destination": "/frontend/signpg/:path*"
    }
  ]
}